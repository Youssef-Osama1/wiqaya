# ========================= App =========================
APP_NAME="wiqaya"
APP_VERSION="0.1.0"
ENV="dev"
# comma-separated origins allowed to call the API from a browser (the Vite dev server)
CORS_ORIGINS="http://localhost:5173"

# ========================= LLM backends =========================
# "openai" | "cohere" — switches which LangChain chat/embedding wrapper the factories build
GENERATION_BACKEND="openai"
EMBEDDING_BACKEND="openai"
RERANKER_BACKEND="cohere"

OPENAI_API_KEY=""
COHERE_API_KEY=""

GENERATION_MODEL_ID="gpt-4o-mini"
GENERATION_TEMPERATURE=0.0

EMBEDDING_MODEL_ID="text-embedding-3-small"

RERANKER_MODEL_ID="rerank-v3.5"

# ========================= Vector DB =========================
# "pgvector" | "qdrant" — both run via docker-compose; switch to compare backends
VECTOR_DB_BACKEND="qdrant"
VECTOR_COLLECTION_NAME="wiqaya_chunks"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5500
POSTGRES_DB="wiqaya"

QDRANT_URL="http://localhost:6333"
# only needed for a managed Qdrant (Qdrant Cloud); local docker needs no key
QDRANT_API_KEY=""

# ========================= Chunking =========================
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=800
CHUNK_MIN_TOKENS=120
CHUNK_OVERLAP_TOKENS=80

# ========================= Retrieval =========================
# hybrid_rerank @ k=5 is the calibrated default (Phase 6, real Cohere embeddings+
# rerank): dominates every other mode at every k, and recall@5 already matches
# recall@10 — k=5 gets full recall without the precision dilution of k=10. Reconfirmed
# in Phase 8 after the golden set grew from 18 to 25 questions, no change needed. See
# eval/CALIBRATION.md (Phase 6 matrix) and eval/E2E_ANALYSIS.md (Phase 8 reconfirmation).
DEFAULT_TOP_K=5
RERANK_CANDIDATE_K=20
HYBRID_WEIGHT_SEMANTIC=0.5

# ========================= Guardrails =========================
# Calibrated in Phase 6 from real hybrid_rerank score distributions (see
# eval/CALIBRATION.md) — NOT guessed, and only valid for hybrid_rerank's real
# CohereRerank relevance_score. Plain "hybrid" mode's score is a rank-based display
# proxy (always 1.0 for the top result) with no discriminative value — never gate
# HALT/DOWNGRADE decisions on it. Reconfirmed still correctly separating answerable
# from out-of-scope scores in Phase 8's larger, harder golden set (eval/E2E_ANALYSIS.md).
SIM_HALT_THRESHOLD=0.45
SIM_DOWNGRADE_THRESHOLD=0.65
