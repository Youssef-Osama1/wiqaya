# Environment
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Evaluation run outputs (regenerated by eval harness; golden.jsonl stays versioned)
eval/runs/*.json
# ...except one committed baseline run. Render's free tier has an ephemeral filesystem and
# wipes anything written at runtime, so a shipped report is the only way the deployed
# dashboard shows real numbers without a ten-minute re-run. A later run sorts after this
# filename and takes precedence locally; to refresh the baseline, commit the newer file
# and drop this exception for the old one.
!eval/runs/e2e_20260819T091041Z.json

# Docker volumes / local state
docker/volumes/

# IDE
.vscode/*
!.vscode/settings.json

# OS
.DS_Store

# Frontend
frontend/node_modules/
frontend/dist/

# AI assistant working notes (repo should read as hand-written)
CLAUDE.md
.claude/
